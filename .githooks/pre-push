#!/usr/bin/env bash
# pre-push hook: run the quality gates before a branch is pushed.
#
# git passes one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# The decision uses the remote ref, because "git push origin HEAD:x" passes
# the literal local ref HEAD. Tag-only pushes and branch deletions (local sha
# of zeros) run nothing. Bypass in an emergency: git push --no-verify
# (the CI still enforces the gates).
set -euo pipefail

zero=0000000000000000000000000000000000000000
run=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == refs/heads/* && "$local_sha" != "$zero" ]]; then
    run=1
  fi
done

if ((run)); then
  exec "$(git rev-parse --show-toplevel)/tools/check.sh"
fi
